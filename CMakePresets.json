{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON"
            }
        },
        {
            "name": "ninja",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja"
        },
        {
            "name": "msvc",
            "hidden": true,
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },
        {
            "name": "win-llvm",
            "hidden": true,
            "inherits": "ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_C_FLAGS": "/W0",
                "CMAKE_CXX_FLAGS": "/W0 /EHsc",
                "VDEPS_USE_LLVM": "ON"
            }
        },
        {
            "name": "linux-clang",
            "hidden": true,
            "inherits": "ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-21",
                "CMAKE_CXX_COMPILER": "clang++-21",
                "CMAKE_C_FLAGS": "-w",
                "CMAKE_CXX_FLAGS": "-w"
            }
        },
        {
            "name": "macos-clang",
            "hidden": true,
            "inherits": "ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm@17/bin/clang",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm@17/bin/clang++",
                "CMAKE_C_FLAGS": "-w",
                "CMAKE_CXX_FLAGS": "-w -stdlib=libc++",
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
                "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++"
            },
            "environment": {
                "MACOSX_DEPLOYMENT_TARGET": "14.0"
            }
        },

        {
            "name": "windows-msvc-debug",
            "displayName": "Windows MSVC Debug (/MTd)",
            "inherits": "msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VDEPS_DYNAMIC_RUNTIME": "OFF"
            }
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows MSVC Release (/MT)",
            "inherits": "msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "VDEPS_DYNAMIC_RUNTIME": "OFF"
            }
        },
        {
            "name": "windows-msvc-md-debug",
            "displayName": "Windows MSVC MD Debug (/MDd)",
            "inherits": "msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VDEPS_DYNAMIC_RUNTIME": "ON"
            }
        },
        {
            "name": "windows-msvc-md-release",
            "displayName": "Windows MSVC MD Release (/MD)",
            "inherits": "msvc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "VDEPS_DYNAMIC_RUNTIME": "ON"
            }
        },

        {
            "name": "windows-llvm-debug",
            "displayName": "Windows LLVM Debug (/MTd)",
            "inherits": "win-llvm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VDEPS_DYNAMIC_RUNTIME": "OFF"
            }
        },
        {
            "name": "windows-llvm-release",
            "displayName": "Windows LLVM Release (/MT)",
            "inherits": "win-llvm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "VDEPS_DYNAMIC_RUNTIME": "OFF"
            }
        },
        {
            "name": "windows-llvm-md-debug",
            "displayName": "Windows LLVM MD Debug (/MDd)",
            "inherits": "win-llvm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VDEPS_DYNAMIC_RUNTIME": "ON"
            }
        },
        {
            "name": "windows-llvm-md-release",
            "displayName": "Windows LLVM MD Release (/MD)",
            "inherits": "win-llvm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "VDEPS_DYNAMIC_RUNTIME": "ON"
            }
        },

        {
            "name": "windows-llvm-address-debug",
            "displayName": "Windows LLVM ASan Debug (/MT)",
            "inherits": "win-llvm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VDEPS_DYNAMIC_RUNTIME": "OFF",
                "VDEPS_USE_LLVM": "ON",
                "VDEPS_SANITIZE": "address"
            }
        },
        {
            "name": "windows-llvm-address-release",
            "displayName": "Windows LLVM ASan Release (/MT)",
            "inherits": "win-llvm",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "VDEPS_DYNAMIC_RUNTIME": "OFF",
                "VDEPS_USE_LLVM": "ON",
                "VDEPS_SANITIZE": "address"
            }
        },

        {
            "name": "linux-debug",
            "displayName": "Linux Debug (clang-21)",
            "inherits": "linux-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release (clang-21)",
            "inherits": "linux-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },

        {
            "name": "linux-address-debug",
            "displayName": "Linux ASan+UBSan Debug (clang-21)",
            "inherits": "linux-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VDEPS_SANITIZE": "address,undefined"
            }
        },
        {
            "name": "linux-address-release",
            "displayName": "Linux ASan+UBSan Release (clang-21)",
            "inherits": "linux-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VDEPS_SANITIZE": "address,undefined"
            }
        },
        {
            "name": "linux-thread-debug",
            "displayName": "Linux TSan Debug (clang-21)",
            "inherits": "linux-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VDEPS_SANITIZE": "thread"
            }
        },
        {
            "name": "linux-thread-release",
            "displayName": "Linux TSan Release (clang-21)",
            "inherits": "linux-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VDEPS_SANITIZE": "thread"
            }
        },

        {
            "name": "macos-debug",
            "displayName": "macOS Debug (llvm@17)",
            "inherits": "macos-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-release",
            "displayName": "macOS Release (llvm@17)",
            "inherits": "macos-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },

        {
            "name": "macos-address-debug",
            "displayName": "macOS ASan+UBSan Debug (llvm@17)",
            "inherits": "macos-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VDEPS_SANITIZE": "address,undefined"
            }
        },
        {
            "name": "macos-address-release",
            "displayName": "macOS ASan+UBSan Release (llvm@17)",
            "inherits": "macos-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VDEPS_SANITIZE": "address,undefined"
            }
        }
    ],
    "buildPresets": [
        { "name": "windows-msvc-debug",       "configurePreset": "windows-msvc-debug",       "configuration": "Debug" },
        { "name": "windows-msvc-release",     "configurePreset": "windows-msvc-release",     "configuration": "RelWithDebInfo" },
        { "name": "windows-msvc-md-debug",    "configurePreset": "windows-msvc-md-debug",    "configuration": "Debug" },
        { "name": "windows-msvc-md-release",  "configurePreset": "windows-msvc-md-release",  "configuration": "RelWithDebInfo" },
        { "name": "windows-llvm-debug",       "configurePreset": "windows-llvm-debug" },
        { "name": "windows-llvm-release",     "configurePreset": "windows-llvm-release" },
        { "name": "windows-llvm-md-debug",    "configurePreset": "windows-llvm-md-debug" },
        { "name": "windows-llvm-md-release",  "configurePreset": "windows-llvm-md-release" },
        { "name": "windows-llvm-address-debug",   "configurePreset": "windows-llvm-address-debug" },
        { "name": "windows-llvm-address-release", "configurePreset": "windows-llvm-address-release" },
        { "name": "linux-debug",              "configurePreset": "linux-debug" },
        { "name": "linux-release",            "configurePreset": "linux-release" },
        { "name": "linux-address-debug",      "configurePreset": "linux-address-debug" },
        { "name": "linux-address-release",    "configurePreset": "linux-address-release" },
        { "name": "linux-thread-debug",       "configurePreset": "linux-thread-debug" },
        { "name": "linux-thread-release",     "configurePreset": "linux-thread-release" },
        { "name": "macos-debug",              "configurePreset": "macos-debug" },
        { "name": "macos-release",            "configurePreset": "macos-release" },
        { "name": "macos-address-debug",      "configurePreset": "macos-address-debug" },
        { "name": "macos-address-release",    "configurePreset": "macos-address-release" }
    ],
    "testPresets": [
        { "name": "windows-msvc-debug",       "configurePreset": "windows-msvc-debug",       "configuration": "Debug" },
        { "name": "windows-msvc-release",     "configurePreset": "windows-msvc-release",     "configuration": "RelWithDebInfo" },
        { "name": "windows-msvc-md-debug",    "configurePreset": "windows-msvc-md-debug",    "configuration": "Debug" },
        { "name": "windows-msvc-md-release",  "configurePreset": "windows-msvc-md-release",  "configuration": "RelWithDebInfo" },
        { "name": "windows-llvm-debug",       "configurePreset": "windows-llvm-debug" },
        { "name": "windows-llvm-release",     "configurePreset": "windows-llvm-release" },
        { "name": "windows-llvm-md-debug",    "configurePreset": "windows-llvm-md-debug" },
        { "name": "windows-llvm-md-release",  "configurePreset": "windows-llvm-md-release" },
        { "name": "windows-llvm-address-debug",   "configurePreset": "windows-llvm-address-debug" },
        { "name": "windows-llvm-address-release", "configurePreset": "windows-llvm-address-release" },
        { "name": "linux-debug",              "configurePreset": "linux-debug" },
        { "name": "linux-release",            "configurePreset": "linux-release" },
        { "name": "linux-address-debug",      "configurePreset": "linux-address-debug" },
        { "name": "linux-address-release",    "configurePreset": "linux-address-release" },
        { "name": "linux-thread-debug",       "configurePreset": "linux-thread-debug" },
        { "name": "linux-thread-release",     "configurePreset": "linux-thread-release" },
        { "name": "macos-debug",              "configurePreset": "macos-debug" },
        { "name": "macos-release",            "configurePreset": "macos-release" },
        { "name": "macos-address-debug",      "configurePreset": "macos-address-debug" },
        { "name": "macos-address-release",    "configurePreset": "macos-address-release" }
    ]
}
